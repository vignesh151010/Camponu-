# ==============================================================================
# CAMPON U Backend Environment Configuration (.env.example)
# Duplicate this file as .env in the backend folder and update the values.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Database Connection (MySQL 8.0)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
# Example: mysql+pymysql://root:MySecretPass123@127.0.0.1:3306/campon_u
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/campon_u

# Security & Session Settings
# Generate a cryptographically secure random secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production
SESSION_COOKIE_NAME=camponu_session
SESSION_EXPIRE_MINUTES=1440
CSRF_COOKIE_NAME=camponu_csrf

# CORS Configuration (comma-separated origins allowed to talk to backend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local File Storage for Assignments & Study Materials
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=15728640

# AI Assistant Settings (Supports Ollama locally or Cloud API)
AI_PROVIDER=ollama
AI_MODEL=llama3
AI_API_BASE_URL=http://127.0.0.1:11434
AI_API_KEY=
AI_TIMEOUT_SECONDS=30

# Academic & College Policies
ATTENDANCE_WARNING_THRESHOLD=75.0
TIMEZONE=UTC
